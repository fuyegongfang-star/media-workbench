# ===== 生产部署环境变量模板（docker-compose.prod.yml 专用）=====
# 一键用法（推荐）：./deploy/bootstrap.sh 自动生成 .env 并完成全套部署，本文件仅作模板。
# 手动用法：cp deploy/.env.prod.example .env → 逐项把 <...> 换成真实值 → node scripts/preflight.mjs
# 与开发模板 .env.example 的关键差异：容器主机名 postgres/redis、HOST=0.0.0.0、真实域名 CORS。
# ⚠ .env 绝不入库（.gitignore 已忽略）；密钥禁止硬编码、禁止写入日志。
# ⚠ DATABASE_URL 里的口令必须与 POSTGRES_PASSWORD 完全一致，否则应用连不上库。

# --- 应用 ---
NODE_ENV=production
PORT=3001
# 容器内必须监听 0.0.0.0，否则 nginx 容器访问不到 API
HOST=0.0.0.0
API_PREFIX=api
# 改成你的真实域名（多个来源用逗号分隔）；同源反代时 CORS 不触发，但仍需填对
CORS_ORIGIN=https://your-domain.com
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_MASTER_KEY=<64位hex主密钥>

# --- 数据库 PostgreSQL 16（主机名必须是 compose 服务名 postgres）---
DATABASE_URL=postgresql://mwuser:<数据库口令>@postgres:5432/media_workbench?schema=public
POSTGRES_USER=mwuser
POSTGRES_PASSWORD=<数据库口令>
POSTGRES_DB=media_workbench

# --- Redis（BullMQ；主机名必须是 compose 服务名 redis）---
REDIS_HOST=redis
REDIS_PORT=6379
# 默认留空：Redis 不暴露宿主端口，仅在 compose 内网可达。
# 如需设密码，填真实值且不要带尖括号（客户端会读取 REDIS_PASSWORD）；留空则不要填占位符。
REDIS_PASSWORD=
BULLMQ_PREFIX=media-workbench

# --- 认证（首期单用户；首次登录后立刻改密）---
# 生成：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<随机长字符串>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
INITIAL_USERNAME=admin
INITIAL_PASSWORD=<强口令至少12位>

# --- OpenAI 兼容模型供应商（Phase 2/3 AI 功能必需；不填则 AI 调用失败但服务照常启动）---
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=<供应商APIKey>

# --- 朱雀检测 / 第三方润色（可留空）---
TEXT_DETECT_BASE_URL=
TEXT_DETECT_API_KEY=
TEXT_POLISH_BASE_URL=
TEXT_POLISH_API_KEY=

# --- 文件存储（容器内路径，由 compose 卷持久化）---
STORAGE_ROOT=/app/storage
MEDIA_MAX_UPLOAD_BYTES=52428800

# --- 备份（deploy/backup.sh 通过 compose 在容器内执行，宿主机无需 psql / Node）---
# 一键部署时 bootstrap.sh 会自动改成本仓库 backups/ 的绝对路径；手动部署请改成实际路径
BACKUP_ROOT=/opt/media-workbench/backups

# --- 生产编排 ---
# 默认只绑 127.0.0.1，由宝塔站点反代并终止 HTTPS；若无反代、要直接公网访问则改 0.0.0.0
WEB_HOST=127.0.0.1
WEB_PORT=8080
# 设 1 可跳过容器启动时的自动 prisma migrate deploy
SKIP_MIGRATE=0
