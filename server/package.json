{
  "name": "@media-workbench/server",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS API 服务（模块化单体，含 Prisma / BullMQ 接入点）",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "worker": "node -e \"console.log('[info] BullMQ Worker 内嵌于 API 进程（TaskWorkerService），执行 npm start 即自动启动，无需独立进程')\""
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.2.8",
    "@node-rs/argon2": "^2.0.1",
    "@prisma/client": "^6.19.3",
    "@types/nodemailer": "^8.0.2",
    "bullmq": "^5.81.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "nodemailer": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "prisma": "^6.19.3",
    "typescript": "^5.9.3"
  }
}
