# ===== 复制为 .env 后填写真实值；.env 绝不入库（见 .gitignore）=====
# 所有密钥/口令只走环境变量，禁止硬编码、禁止写日志
# ⚠ 生产容器部署请勿直接用本模板，改用 deploy/.env.prod.example（主机名/监听地址/域名均不同）

# --- 应用 ---
NODE_ENV=development
# API 服务端口（NestJS）
PORT=3001
# 监听地址：main.ts 默认 127.0.0.1（仅本机开发）；容器内/生产必须是 0.0.0.0
HOST=127.0.0.1
# 允许的前端来源，逗号分隔；生产环境必须改为真实域名
CORS_ORIGIN=http://localhost:5173
# 全局前缀，默认 api
API_PREFIX=api
# AES-256 主密钥（用于加密模型/检测/润色供应商密钥后入 SystemConfig）
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_MASTER_KEY=<64位hex主密钥>

# --- 数据库 PostgreSQL 16 ---
# 应用连接串（server 用）
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/media_workbench?schema=public
# docker-compose 使用的库名/账号/口令，与上面的连接串保持一致
POSTGRES_USER=<user>
POSTGRES_PASSWORD=<password>
POSTGRES_DB=media_workbench
POSTGRES_PORT=5432

# --- Redis（BullMQ 队列）---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<留空或填写>
# 队列名前缀
BULLMQ_PREFIX=media-workbench

# --- 认证（T1.2 使用；首期单用户）---
JWT_SECRET=<随机长字符串>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# 首期单用户初始账号（仅启动时播种一次；生产请首次登录后立即改密或改用真实 IdP）
INITIAL_USERNAME=admin
INITIAL_PASSWORD=<初始登录口令，至少6位>

# --- OpenAI 兼容模型供应商（Phase 2/3 联调用，密钥仅存此处或加密入库）---
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=<供应商APIKey>

# --- 朱雀检测 / 第三方润色（Phase 3 用，暂无凭据可留空）---
TEXT_DETECT_BASE_URL=<检测服务地址>
TEXT_DETECT_API_KEY=<检测服务密钥>
TEXT_POLISH_BASE_URL=<润色服务地址>
TEXT_POLISH_API_KEY=<润色服务密钥>

# --- 文件存储（T1.4）---
STORAGE_ROOT=./storage
# 单文件大小上限（字节），默认 50MB；超过将被拒绝
MEDIA_MAX_UPLOAD_BYTES=52428800

# --- 备份（T1.6，见 restore.md）---
BACKUP_ROOT=./backups

# --- 生产编排（docker-compose.prod.yml，见 deploy/README.md）---
# nginx 对外端口与绑定地址；默认仅绑本机回环，由宝塔站点反代并终止 HTTPS
WEB_PORT=8080
WEB_HOST=127.0.0.1
# 设为 1 可跳过容器启动时的自动 prisma migrate deploy
SKIP_MIGRATE=0
